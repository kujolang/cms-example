CMS_BASE_URL=http://127.0.0.1:4200
# Optional override. Local startup generates a private token in .data when omitted.
CMS_API_TOKEN=
# Enable app-owned password sign-in only when this public deployment is intended to support it.
# CMS_STUDIO_ALLOW_PASSWORD_LOGIN=true
# Only behind a trusted ingress that removes client-supplied identity and secret
# headers, authenticates the user, and injects both identity and this secret.
# CMS_PLATFORM_IDENTITY_SECRET=<random secret of at least 32 characters>
